# Copie para .env e preencha. O .env NÃO é versionado.

# Garmin — só é usado quando o token de ~/.garminconnect expira (~1x por ano).
# No dia a dia o garmin_pull.py retoma a sessão do token e não toca nestas linhas.
GARMIN_EMAIL=
GARMIN_PASSWORD=

# Renpho (balança) — usado em TODA execução: a lib não guarda token.
# Sem estas duas linhas o renpho_pull.py sai com erro e o brief fica sem peso.
RENPHO_EMAIL=
RENPHO_PASSWORD=
